#!/bin/bash
set -e

# Preparar la base de datos si estamos arrancando el servidor Rails
if [[ "$*" == *"rails"* && "$*" == *"server"* ]]; then
  echo "==> Verificando y preparando base de datos..."
  ./bin/rails db:prepare || echo "==> Aviso: db:prepare falló o tardó demasiado, continuando con el arranque del servidor..."
fi

exec "${@}"
